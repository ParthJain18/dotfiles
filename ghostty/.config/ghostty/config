# font-family = "Your Preferred Nerd Font"
font-size = 12

# Ghostty comes with hundreds of themes built-in
theme = "Ayu Mirage" 
# Blazer, Blueloco Dark, Catpuccin Mocha, Elegant

# Add a little breathing room around the edges
window-padding-x = 10
window-padding-y = 10

# Hide the standard Linux title bar for a cleaner, modern look
window-decoration = false

keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:top
keybind = ctrl+shift+down=goto_split:bottom
